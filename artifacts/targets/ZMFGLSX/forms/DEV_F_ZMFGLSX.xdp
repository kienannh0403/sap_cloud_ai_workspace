<?formServer defaultPDFRenderFormat acrobat10.0dynamic?>
<subform name="Form" layout="tb" locale="vi_VN" restoreState="auto">
  <pageSet>
    <pageArea name="Page1" id="Page1">
      <medium stock="a4" short="210mm" long="297mm" orientation="landscape"/>
      <contentArea x="10mm" y="30mm" w="277mm" h="170mm"/>
      <field name="Logo" x="10mm" y="5mm" w="30mm" h="22mm"><ui><imageEdit data="embed"/></ui><value><image aspect="fit" contentType="image/png"/></value><bind match="dataRef" ref="$record.Header.Logo"/></field><field name="PlantName" x="45mm" y="7mm" w="200mm" h="7mm"><ui><textEdit/></ui><font typeface="Arial" size="11pt" weight="bold"/><para hAlign="left" vAlign="middle"/><bind match="dataRef" ref="$record.Header.PlantName"/></field><field name="PlantAddress" x="45mm" y="15mm" w="200mm" h="7mm"><ui><textEdit/></ui><font typeface="Arial" size="10pt"/><para hAlign="left" vAlign="middle"/><bind match="dataRef" ref="$record.Header.PlantAddress"/></field><field name="PageNo" x="10mm" y="200mm" w="277mm" h="5mm"><ui><textEdit/></ui><font typeface="Arial" size="10pt"/><para hAlign="right"/><event activity="ready" ref="$layout" name="event__layout_ready"><script contentType="application/x-javascript" runAt="both">this.rawValue = xfa.layout.page(this) + "/" + xfa.layout.pageCount();</script></event><bind match="none"/></field>
    </pageArea>
  </pageSet>
  <draw name="Text1" w="277mm" h="14mm"><ui><textEdit/></ui><value><text>LỆNH SẢN XUẤT</text></value><font typeface="Arial" size="16pt" weight="bold"/><margin topInset="0mm"/><para hAlign="center" vAlign="middle"/></draw>
  <subform name="Order" layout="lr-tb" w="277mm"><bind match="dataRef" ref="$.Order"/><margin bottomInset="2mm"/><field name="OrderType" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Loại lệnh sản xuất:</text></value></caption><bind match="dataRef" ref="$.OrderType"/></field><field name="ProductionOrder" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Lệnh sản xuất:</text></value></caption><bind match="dataRef" ref="$.ProductionOrder"/></field><field name="Material" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Mã sản phẩm:</text></value></caption><bind match="dataRef" ref="$.Material"/></field><field name="Quantity" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Số lượng:</text></value></caption><bind match="dataRef" ref="$.Quantity"/></field><field name="MaterialText" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Tên sản phẩm:</text></value></caption><bind match="dataRef" ref="$.MaterialText"/></field><field name="BasicStartDate" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Ngày dự kiến sản xuất:</text></value></caption><bind match="dataRef" ref="$.BasicStartDate"/></field><field name="Specification" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Quy cách sản phẩm:</text></value></caption><bind match="dataRef" ref="$.Specification"/></field><field name="BasicFinishDate" w="138.5mm" minH="7mm"><ui><textEdit multiLine="1"/></ui><font typeface="Arial" size="10pt"/><para vAlign="middle"/><caption reserve="60mm"><font typeface="Arial" size="10pt" weight="bold"/><para vAlign="middle"/><value><text>Ngày dự kiến hoàn thành:</text></value></caption><bind match="dataRef" ref="$.BasicFinishDate"/></field></subform>
  <draw name="Text2" w="277mm" h="9mm"><ui><textEdit/></ui><value><text>1.      Công đoạn thực hiện</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="3mm"/><para hAlign="left" vAlign="bottom"/></draw>
  <subform name="Operations" layout="table" columnWidths="17mm 38mm 25mm 22mm 20mm 13mm 21mm 20mm 21mm 20mm 20mm 40mm" w="277mm"><bind match="dataRef" ref="$.Operations"/><overflow leader="HeaderRow"/><subform name="HeaderRow" layout="row"><draw name="H10" w="17mm" h="12mm"><ui><textEdit multiLine="1"/></ui><value><text>Mã công đoạn</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.8mm" rightInset="0.8mm"/><para hAlign="center" vAlign="middle"/><border><edge thickness="0.15mm"/><fill><color value="217,217,217"/></fill></border></draw><draw name="H11" w="38mm" h="12mm"><ui><textEdit multiLine="1"/></ui><value><text>Mô tả công đoạn</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.8mm" rightInset="0.8mm"/><para hAlign="center" vAlign="middle"/><border><edge thickness="0.15mm"/><fill><color value="217,217,217"/></fill></border></draw><draw name="H12" w="25mm" h="12mm"><ui><textEdit multiLine="1"/></ui><value><text>Tổ thực hiện</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.8mm" rightInset="0.8mm"/><para hAlign="center" vAlign="middle"/><border><edge thickness="0.15mm"/><fill><color value="217,217,217"/></fill></border></draw><draw name="H13" w="22mm" h="12mm"><ui><textEdit multiLine="1"/></ui><value><text>Ngày thực tế thực hiện</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.8mm" rightInset="0.8mm"/><para hAlign="center" vAlign="middle"/><border><edge thickness="0.15mm"/><fill><color value="217,217,217"/></fill></border></draw><draw name="H14" w="20mm" h="12mm"><ui><textEdit multiLine="1"/></ui><value><text>Thời gian sản xuất</text></value><font typeface="Arial" size="10pt" weight="bold"/><margin topInset="0.5mm" bottomInset="0.5mm" leftInset="0.8mm" rightInset="0.8mm"/><para hAlig
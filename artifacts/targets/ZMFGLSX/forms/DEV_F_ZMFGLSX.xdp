  <subform name="WriteLine22" layout="lr-tb" w="277mm"><bind match="none"/><draw name="Label" w="72mm" h="10mm"><ui><textEdit/></ui><value><text>Tổng số lượng sản phẩm đạt nhập kho:</text></value><font typeface="Arial" size="10pt"/><para vAlign="bottom"/></draw><draw name="Line" w="205mm" h="10mm"><ui><textEdit/></ui><border><edge presence="hidden"/><edge presence="hidden"/><edge stroke="dotted" thickness="0.3mm"/><edge presence="hidden"/></border></draw></subform>
